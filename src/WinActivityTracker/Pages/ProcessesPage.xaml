<Page
    x:Class="WinActivityTracker.Pages.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:WinActivityTracker.Ui.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Итог за выбранный период -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="12,0,0,16">
            <TextBlock x:Name="SummaryLabel" Text="Всего за сегодня"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
            <TextBlock x:Name="SummaryTotal" Text="-" FontSize="28" FontWeight="SemiBold" LineHeight="32" />
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#A082F5" />
                    <TextBlock x:Name="SummaryGames" Text="Игры -" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#4CC2FF" />
                    <TextBlock x:Name="SummaryApps" Text="Приложения -" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <ctl:ActivityGridView x:Name="GridView" Grid.Row="1" />
    </Grid>
</Page>
