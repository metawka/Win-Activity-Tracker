<Page
    x:Class="WinActivityTracker.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left" Margin="4,0,4,8">

            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Учёт активности" />
                        <TextBlock Text="Автоматический запуск фонового учёта при входе в систему."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="AutostartToggle" OnContent="" OffContent=""
                                  MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                  Toggled="Autostart_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Периодичность опроса" />
                        <TextBlock Text="Интервал проверки активного окна, в секундах."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <muxc:NumberBox Grid.Column="1" x:Name="IntervalBox" Minimum="1" Maximum="60"
                                    SpinButtonPlacementMode="Compact" Width="132"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    ValueChanged="Interval_ValueChanged" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Считать полноэкранные приложения играми" />
                        <TextBlock Text="Возможны ложные срабатывания на медиаплеерах и средствах захвата экрана."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" x:Name="FullscreenToggle" OnContent="" OffContent=""
                                  MinWidth="0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                  Toggled="Fullscreen_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Расположение данных" />
                        <TextBlock x:Name="DataPathText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Открыть папку" VerticalAlignment="Center" HorizontalAlignment="Right" Click="OpenData_Click" />
                </Grid>
            </Border>

            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="12" Margin="4,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
