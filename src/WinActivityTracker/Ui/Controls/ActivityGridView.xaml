<UserControl
    x:Class="WinActivityTracker.Ui.Controls.ActivityGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:WinActivityTracker.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="RowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="0" MaxWidth="1180" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка колонок -->
        <Grid Grid.Row="0" Padding="12,6,12,6" ColumnSpacing="8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Имя" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="Категория" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="Процесс" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
            <Button Grid.Column="4" x:Name="SortButton" Click="SortButton_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"
                    Background="Transparent" BorderThickness="0" Padding="8,2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Время" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <FontIcon x:Name="SortCaret" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView Grid.Row="1" x:Name="List" SelectionMode="None"
                  ItemContainerStyle="{StaticResource RowStyle}"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  RightTapped="List_RightTapped"
                  Background="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="ui:ActivityRow">
                    <Grid Height="32" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Width="16" Height="16" Source="{x:Bind IconSource}" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Text="{x:Bind AppName}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontSize="13" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind PillBrush}" />
                            <TextBlock Text="{x:Bind CategoryLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{x:Bind Process}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" FontSize="13" />

                        <Grid Grid.Column="4">
                            <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind HeatOpacity}"
                                       RadiusX="3" RadiusY="3" Margin="0,3" />
                            <TextBlock Text="{x:Bind TimeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,10,0" FontSize="13"
                                       FontFamily="Consolas, Cascadia Mono, Segoe UI" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" x:Name="EmptyLabel" Visibility="Collapsed"
                   Text="Пока нет данных. Поработайте немного, потом обновите."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
